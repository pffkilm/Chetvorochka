<Page x:Class="ChetverochkaKassa.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChetverochkaKassa.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMenuPage">

    <Grid>
        <StackPanel>
            <Button Width="200"  Height="40" Name="btnSale" Click="btSale_Click"  >Оформление продаж</Button>
            <Button  Width="200"  Height="40" Name="btnProducts" Click="btnProducts_Click" >Товары</Button>
            <Button  Width="200"  Height="40" Name="btnUser" Click="btnUser_Click" >Пользователи</Button>
            <Button  Width="200"  Height="40" Name="btnReport" Click="btnReport_Click" >Отчеты</Button>
            <Button  Width="200"  Height="40" x:Name="goBack" Click="goBack_Click">Выйти</Button>
        </StackPanel>
    </Grid>
</Page>
