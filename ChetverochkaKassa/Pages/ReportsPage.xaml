<Page x:Class="ChetverochkaKassa.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChetverochkaKassa.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportsPage">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="10">

                <TextBlock>Отчеты</TextBlock>

                <TextBlock>Продажи за период</TextBlock>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">С:</TextBlock>
                    <DatePicker Name="startDate" Margin="0,0,5,0"></DatePicker>
                    <TextBlock Margin="0,0,5,0">По:</TextBlock>
                    <DatePicker Name="endDate" Margin="0,0,5,0"></DatePicker>
                    <Button Name="otchet" Click="otchet_Click" Margin="0,0,5,0" >Сформировать</Button>
                </StackPanel>


                <TextBlock x:Name="infoTb"></TextBlock>

                <TextBlock>По кассирам(за период):</TextBlock>
                <DataGrid x:Name="cashiersDg" AutoGenerateColumns="False"  IsReadOnly="True" Height="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Кассир" Binding="{Binding Cashier}"/>
                        <DataGridTextColumn Header="Продаж" Binding="{Binding Count}"/>
                        <DataGridTextColumn Header="Выручка" Binding="{Binding Mouney}"/>
                    </DataGrid.Columns>

                </DataGrid>


                <TextBlock>История клиентов:</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0, 10,0,0">Телефон:</TextBlock>
                    <TextBox Width="200" x:Name="clientPhoneTb" Margin="0, 10,0,0"></TextBox>
                    <Button x:Name="searchClient" Click="searchClient_Click" Margin="0, 10,0,0">Найти</Button>
                </StackPanel>
                <DataGrid x:Name="clientDg" AutoGenerateColumns="False" IsReadOnly="True" Height="150" Margin="0,10,0,0" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}"/>
                        <DataGridTextColumn Header="Оплата" Binding="{Binding Pay}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Назад" Click="goBack_Click" Width="100" ></Button>
            </StackPanel>

        
        </ScrollViewer>
    </Grid>
</Page>
