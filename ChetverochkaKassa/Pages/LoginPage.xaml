<Page x:Class="ChetverochkaKassa.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChetverochkaKassa.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход">
   
    <Grid>
        <StackPanel Width="300"   VerticalAlignment="Center" >
            <TextBlock HorizontalAlignment="Center" FontSize="18">Вход</TextBlock>
            <TextBox Name="txtLogin" Margin="0, 10" Height="30"></TextBox>
            <PasswordBox Name="pbPassword" Height="30"></PasswordBox>
            <Button Click="Button_Click" Margin="0, 10, 0, 0" Height="30" Background="AntiqueWhite"  FontSize="18" >Войти</Button>
        </StackPanel>


    </Grid>
</Page>
