<Window x:Class="ChetverochkaKassa.RegisterClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChetverochkaKassa"
        mc:Ignorable="d"
        Title="RegisterClientWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock>Регистрация клиента</TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Телефон:</TextBlock>
                <TextBox x:Name="PhoneTb" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Фамилия:</TextBlock>
                <TextBox x:Name="LastNameTb" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Имя:</TextBlock>
                <TextBox x:Name="FirstNameTb" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Отчество:</TextBlock>
                <TextBox x:Name="NameTb" Width="200"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock>Дата рождения:</TextBlock>
                <DatePicker Name="Birthday"></DatePicker>
            </StackPanel>
            <Button Click="Button_Click">Сохранить</Button>
        </StackPanel>
    </Grid>
</Window>
